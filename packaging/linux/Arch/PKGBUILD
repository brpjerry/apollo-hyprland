# Arch Linux package for the Hyprland port of Apollo.
#
# A plain `makepkg` builds the release tag v$pkgver from GitHub. CI builds the commit under test instead:
#   _source="git+file://$PWD" _ref="commit=$(git rev-parse HEAD)" makepkg
# _run_unit_tests=true also builds the unit tests and runs them in check().
#
# The release version is pkgver: bump it here before tagging, and tag the release v$pkgver
# (.github/workflows/release.yml refuses a tag that does not match).

: "${_run_unit_tests:=false}"

pkgname='apollo-hyprland'
pkgver=0.4.8.1
pkgrel=1
pkgdesc='Self-hosted game stream host for Artemis, with virtual displays on Hyprland'
arch=('x86_64')
url='https://github.com/brpjerry/apollo-hyprland'
license=('GPL-3.0-only')
install=sunshine.install
# No separate -debug package (release assets carry exactly one package), and no LTO, which the project is not
# built or tested with.
options=('!debug' '!lto')

depends=(
  'avahi'
  'curl'
  'glib2'
  'gtk3'
  'icu'
  'libayatana-appindicator'
  'libcap'
  'libdrm'
  'libevdev'
  'libice'
  'libmfx'
  'libnotify'
  'libpulse'
  'libsm'
  'libva'
  'libx11'
  'libxcb'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxtst'
  'mesa'
  'miniupnpc'
  'numactl'
  'openssl'
  'opus'
  'systemd-libs'
  'wayland'
  'which'
)

# CUDA is only needed to build NVENC support: the CUDA runtime is linked statically, and at run time the encoder
# uses the NVIDIA driver's libcuda.
makedepends=(
  'boost'
  'cmake'
  'cuda'
  'git'
  'ninja'
  'nlohmann-json'
  'nodejs'
  'npm'
  'systemd'
  'wayland-protocols'
)

optdepends=(
  'hyprland: virtual displays and per-stream workspaces'
  'libva-mesa-driver: AMD GPU encoding support'
  'nvidia-utils: NVIDIA GPU encoding support (NVENC)'
  'polkit: run commands marked "Elevated" as root (pkexec)'
  'xdg-utils: open commands that are URLs (xdg-open)'
  'xdg-terminal-exec: elevation_method = terminal'
)

# Upstream Apollo and Sunshine install the same /usr/bin/sunshine.
conflicts=('apollo' 'sunshine')

: "${_source:=git+${url}.git}"
: "${_ref:=tag=v${pkgver}}"
source=("apollo::${_source}#${_ref}")
sha256sums=('SKIP')

prepare() {
  cd apollo
  git submodule update --init --recursive
}

build() {
  # Read by cmake/prep/build_version.cmake: the binary reports pkgver as its version.
  export BRANCH=main
  export BUILD_VERSION="${pkgver}"
  COMMIT="$(git -C apollo rev-parse HEAD)"
  export COMMIT

  export CFLAGS="${CFLAGS/-Werror=format-security/}"
  export CXXFLAGS="${CXXFLAGS/-Werror=format-security/}"
  export CUDA_PATH=/opt/cuda

  local _tests=OFF
  [[ "${_run_unit_tests::1}" == "t" ]] && _tests=ON

  cmake -S apollo -B build -G Ninja -Wno-dev \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D BUILD_DOCS=OFF \
    -D BUILD_TESTS="${_tests}" \
    -D BOOST_ALLOW_NEWER_SYSTEM=ON \
    -D SUNSHINE_ENABLE_CUDA=ON \
    -D CMAKE_CUDA_COMPILER=/opt/cuda/bin/nvcc \
    -D SUNSHINE_EXECUTABLE_PATH=/usr/bin/sunshine \
    -D SUNSHINE_ASSETS_DIR=share/apollo \
    -D SUNSHINE_PUBLISHER_ISSUE_URL="${url}/issues"

  # Ninja ignores MAKEFLAGS; honour a -jN from makepkg.conf so a local build can be held back.
  local _jobs=()
  [[ "${MAKEFLAGS:-}" =~ -j[[:space:]]*([0-9]+) ]] && _jobs=(-j "${BASH_REMATCH[1]}")
  cmake --build build "${_jobs[@]}"
}

check() {
  build/sunshine --version

  if [[ "${_run_unit_tests::1}" == "t" ]]; then
    apollo/scripts/hyprland/test.sh "${srcdir}/build" --gtest_color=yes
  fi
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
