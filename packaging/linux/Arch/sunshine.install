# shellcheck shell=bash

# CAP_SYS_ADMIN is only needed for KMS capture, and CAP_SYS_NICE only for a high-priority EGL context, so neither is
# set by default: Wayland capture (wlgrab, used on Hyprland and other wlroots compositors) does not need them, and a
# file capability makes the binary run in secure mode, where the dynamic loader drops LD_* variables from the
# environment.
# KMS users can opt in by installing with APOLLO_ENABLE_KMS_CAPTURE=1 set, or afterwards with:
#   sudo setcap cap_sys_admin,cap_sys_nice+p $(readlink -f /usr/bin/sunshine)
do_setcap() {
  if [ "${APOLLO_ENABLE_KMS_CAPTURE:-0}" = "1" ]; then
    setcap cap_sys_admin,cap_sys_nice+p "$(readlink -f usr/bin/sunshine)"
  else
    echo "Not setting CAP_SYS_ADMIN (only KMS capture needs it). To enable KMS capture, run:"
    echo "  sudo setcap cap_sys_admin,cap_sys_nice+p \$(readlink -f /usr/bin/sunshine)"
  fi
}

# Best effort: none of this works in a container or chroot, and a failure must not fail the install.
do_udev_reload() {
  udevadm control --reload-rules || true
  udevadm trigger --property-match=DEVNAME=/dev/uinput || true
  udevadm trigger --property-match=DEVNAME=/dev/uhid || true
  udevadm trigger --subsystem-match=hidraw || true
  udevadm trigger --subsystem-match=input || true
  modprobe uinput || true
  modprobe uhid || true
}

post_install() {
  do_setcap
  do_udev_reload
}

post_upgrade() {
  do_setcap
  do_udev_reload
}
