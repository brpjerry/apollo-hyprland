[Unit]
Description=@PROJECT_NAME@ - @PROJECT_DESCRIPTION@
# Run inside the graphical session: start after it is up (so WAYLAND_DISPLAY, HYPRLAND_INSTANCE_SIGNATURE and
# DBUS_SESSION_BUS_ADDRESS have been imported into the user manager) and stop with it at logout.
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
@SUNSHINE_SERVICE_START_COMMAND@
@SUNSHINE_SERVICE_STOP_COMMAND@
# Not Restart=always: quitting from the web UI exits with status 0 and must not respawn the service.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
