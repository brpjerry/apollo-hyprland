-      OperationStatus update_pen_tool(PenToolType tool) {
-        if (tool == PenToolType::unchanged || tool == last_tool_) {
+      OperationStatus update_pen_tool(PenToolType requested_tool) {
+        const auto tool = requested_tool == PenToolType::unchanged ? last_tool_ : requested_tool;
+        if (tool == PenToolType::unchanged || (in_proximity_ && tool == last_tool_)) {
           return OperationStatus::success();
         }
+        if (in_proximity_) {
+          // libinput needs the old tool out of proximity, in its own frame, before the new one comes in.
+          if (const auto status = leave_proximity(); !status.ok()) {
+            return status;
+          }
+          if (const auto status = sync(); !status.ok()) {
+            return status;
+          }
+        }
         if (const auto status = emit_pen_tool(tool, 1); !status.ok()) {
           return status;
         }
+        last_tool_ = tool;
+        in_proximity_ = true;
+        return emit_held_buttons(1);
+      }
+
+      /**
+       * @brief Lift the tip and take the tool out of proximity, releasing its buttons on the device.
+       *
+       * @return Emission status; the caller syncs.
+       */
+      OperationStatus leave_proximity() {
+        if (const auto status = emit_event(EV_KEY, BTN_TOUCH, 0); !status.ok()) {
+          return status;
+        }
+        if (const auto status = emit_event(EV_ABS, ABS_PRESSURE, 0); !status.ok()) {
+          return status;
+        }
+        // Buttons still held stay held, and are pressed again when the tool comes back.
+        if (const auto status = emit_held_buttons(0); !status.ok()) {
+          return status;
+        }
         if (const auto status = emit_pen_tool(last_tool_, 0); !status.ok()) {
           return status;
         }
-        last_tool_ = tool;
+        in_proximity_ = false;
+        return OperationStatus::success();
+      }
+
+      /**
+       * @brief Emit a value for each held button.
+       *
+       * @param value 1 to press them, 0 to release them.
+       * @return Emission status.
+       */
+      OperationStatus emit_held_buttons(std::int32_t value) {
+        for (std::size_t index = 0; index < held_buttons_.size(); ++index) {
+          if (!held_buttons_[index]) {
+            continue;
+          }
+          const auto code = pen_button_to_linux(static_cast<PenButton>(index));
+          if (const auto status = emit_event(EV_KEY, static_cast<std::uint16_t>(code), value); !status.ok()) {
+            return status;
+          }
+        }
         return OperationStatus::success();
       }
 
+      OperationStatus emit_pen_rotation(float rotation) {
+        if (rotation < 0.0F) {
+          return OperationStatus::success();
+        }
+        return emit_event(EV_ABS, ABS_Z, tablet_rotation_units(rotation));
+      }
