+    /**
+     * @brief Contact ellipse axes in touchscreen units.
+     *
+     * @param contact Contact whose axes are in viewport pixels.
+     * @return Major and minor axes, both zero when the contact area is unknown.
+     */
+    std::pair<int, int> touch_contact_area_units(const TouchContact &contact) {
+      if (!(contact.contact_major_axis > 0.0F) || contact.viewport.width <= 0 || contact.viewport.height <= 0) {
+        return {0, 0};
+      }
+      // An unknown minor axis means a round contact.
+      const auto major = static_cast<double>(contact.contact_major_axis);
+      const auto minor = contact.contact_minor_axis > 0.0F ? static_cast<double>(contact.contact_minor_axis) : major;
+      const auto units_x = static_cast<double>(touch_axis_max_x) / contact.viewport.width;
+      const auto units_y = static_cast<double>(touch_axis_max_y) / contact.viewport.height;
+      // The major axis points `orientation` degrees clockwise from vertical; the minor axis is perpendicular to it.
+      const auto theta = static_cast<double>(clamp_degrees(contact.orientation)) * std::numbers::pi / 180.0;
+      const auto to_units = [](double value) {
+        return std::clamp(static_cast<int>(std::lround(value)), 1, touch_contact_axis_max);
+      };
+      const auto major_units = to_units(major * std::hypot(std::sin(theta) * units_x, std::cos(theta) * units_y));
+      const auto minor_units = to_units(minor * std::hypot(std::cos(theta) * units_x, std::sin(theta) * units_y));
+      return {std::max(major_units, minor_units), std::min(major_units, minor_units)};
+    }
+
+    /**
+     * @brief ABS_Z for a pen's barrel rotation.
+     *
+     * @param degrees Rotation in degrees clockwise.
+     * @return Axis value; libinput reports ABS_Z as `(value / 360 * 360 + 90) mod 360` degrees.
+     */
+    int tablet_rotation_units(float degrees) {
+      const auto rotation = static_cast<int>(std::lround(degrees)) % 360;
+      return (rotation + 270) % 360;
+    }
+
     int tablet_tilt_units(float degrees) {
       const auto radians = std::clamp(degrees, -90.0F, 90.0F) * static_cast<float>(std::numbers::pi) / 180.0F;
       return static_cast<int>(std::lround(radians * tablet_resolution));
