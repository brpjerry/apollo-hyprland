Subject: [PATCH 2/2] Add send empty payload method

Apollo fork commit
ClassicOldSong/moonlight-common-c@c999436858471dfefa7617af3b7dc03ec1644ce4,
rebased onto moonlight-stream/moonlight-common-c b4ee1cea.
---
 src/ControlStream.c | 13 +++++++++++++
 src/Limelight.h     |  4 ++++
 2 files changed, 17 insertions(+)

diff --git a/src/ControlStream.c b/src/ControlStream.c
index bf06422..60fab52 100644
--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -2354,3 +2354,16 @@ int LiSendExecServerCmd(uint8_t cmdId) {
         false
     );
 }
+
+// Send a server cmd request to the streaming machine
+int LiSendEmptyPayload() {
+    uint8_t payload[4] = {0xAA, 0x55, 0xAA, 0x55};
+    return sendMessageAndForget(
+        0x00,
+        sizeof(payload),
+        payload,
+        CTRL_CHANNEL_SERVERCTL,
+        ENET_PACKET_FLAG_RELIABLE,
+        false
+    );
+}
\ No newline at end of file
diff --git a/src/Limelight.h b/src/Limelight.h
index c1f7e6c..6f44058 100644
--- a/src/Limelight.h
+++ b/src/Limelight.h
@@ -584,6 +584,10 @@ bool LiGetEstimatedRttInfo(uint32_t* estimatedRtt, uint32_t* estimatedRttVarianc
 // This function sends a request to the server to execute the requested cmd id.
 int LiSendExecServerCmd(uint8_t cmdId);
 
+// This function sends an empty payload to the server.
+// This method exists here for workaround client side wifi sleeps.
+int LiSendEmptyPayload();
+
 // This function queues a relative mouse move event to be sent to the remote server.
 int LiSendMouseMoveEvent(short deltaX, short deltaY);
 
